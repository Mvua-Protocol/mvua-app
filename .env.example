# Mvua Protocol Web: environment template.
# Copy to .env.local and fill in. Client visible vars are NEXT_PUBLIC_ and
# never contain secrets. Server-only vars have no prefix.

# Network: "testnet" until mainnet launch
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Stellar endpoints (verify current URLs for the active network)
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed contract IDs (filled after Phase 1 deployment)
NEXT_PUBLIC_CONTRACT_RISK_POOL=
NEXT_PUBLIC_CONTRACT_POLICY=
NEXT_PUBLIC_CONTRACT_ORACLE_ADAPTER=
NEXT_PUBLIC_CONTRACT_TRIGGER_ENGINE=
NEXT_PUBLIC_CONTRACT_PAYOUT_VAULT=

# Indexer read API (server side)
INDEXER_API_URL=
